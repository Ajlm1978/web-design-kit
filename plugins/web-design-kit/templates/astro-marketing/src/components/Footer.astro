---
/**
 * Pie de página. Solo muestra datos de contacto/redes que existan en SITE;
 * nunca rellena huecos con ejemplos.
 */
import { SITE, socialLinks } from '../config/site';

const year = new Date().getFullYear();
const social = socialLinks();
const { email, phone, address } = SITE.contact;
---

<footer class="border-t border-line bg-surface">
  <div class="site-container grid-editorial py-12 md:py-16">
    <div class="col-span-12 md:col-span-5">
      <p class="font-display text-2xl font-semibold tracking-tight">{SITE.name}</p>
      <p class="mt-3 text-sm text-muted">{SITE.description}</p>
    </div>

    <nav aria-label="Pie de página" class="col-span-6 md:col-span-3">
      <p class="eyebrow">Navegación</p>
      <ul class="mt-3 grid gap-2 text-sm" role="list">
        {SITE.nav.map((item) => (
          <li><a href={item.href} class="text-ink no-underline hover:underline">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="col-span-6 md:col-span-4">
      <p class="eyebrow">Contacto</p>
      <address class="mt-3 grid gap-2 text-sm not-italic">
        {email && <a href={`mailto:${email}`} class="text-ink">{email}</a>}
        {phone && <a href={`tel:${phone.replace(/\s+/g, '')}`} class="text-ink">{phone}</a>}
        {address && (
          <span class="text-muted">
            {address.streetAddress}, {address.addressLocality} {address.postalCode}
          </span>
        )}
        {!email && !phone && !address && (
          <span class="text-muted">Datos de contacto pendientes (PLACEHOLDER en site.ts).</span>
        )}
      </address>
      {social.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-4 text-sm" role="list" aria-label="Redes sociales">
          {social.map((s) => (
            <li>
              <a href={s.href} rel="me noopener" target="_blank" class="capitalize text-ink">
                {s.name}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <p class="col-span-12 mt-4 border-t border-line pt-6 text-xs text-muted">
      © {SITE.foundingYear < year ? `${SITE.foundingYear}–${year}` : year} {SITE.name}. Todos los
      derechos reservados.
    </p>
  </div>
</footer>
