---
/**
 * Página de contacto.
 *
 * El formulario NO tiene backend: `action` es PLACEHOLDER. Opciones habituales:
 *  - Cloudflare Workers: un Worker con `fetch` que reciba el POST (o Turnstile + Resend).
 *  - Vercel: una Function en `/api/contact` (requiere adaptador) o un servicio externo.
 *  - Servicios sin servidor: Formspree, Basin, Web3Forms… (poner su URL en `action`).
 * Hasta configurarlo, el envío no hace nada útil; no publiques así.
 */
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import { SITE } from '../config/site';
import { breadcrumb, organization } from '../lib/jsonld';

const FORM_ACTION = '#'; // PLACEHOLDER: URL del endpoint que procesa el formulario.
const { email, phone, address, openingHours } = SITE.contact;
---

<Base
  title="Contacto"
  description={`Habla con ${SITE.name}. Cuéntanos tu proyecto y te respondemos.`}
  jsonLd={[organization(), breadcrumb([{ name: 'Inicio', path: '/' }, { name: 'Contacto', path: '/contacto/' }])]}
>
  <Section id="contacto" eyebrow="Contacto" title="Cuéntanos qué necesitas." as="h1">
    <div class="grid-editorial">
      <form
        method="post"
        action={FORM_ACTION}
        class="reveal col-span-12 grid gap-6 md:col-span-7"
        novalidate={false}
      >
        <div class="grid gap-6 sm:grid-cols-2">
          <div class="grid gap-2">
            <label for="name" class="text-sm font-medium">Nombre</label>
            <input
              id="name"
              name="name"
              type="text"
              required
              autocomplete="name"
              class="rounded-sm border border-line bg-paper px-4 py-3 text-ink"
            />
          </div>
          <div class="grid gap-2">
            <label for="email" class="text-sm font-medium">Correo electrónico</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              inputmode="email"
              class="rounded-sm border border-line bg-paper px-4 py-3 text-ink"
            />
          </div>
        </div>
        <div class="grid gap-2">
          <label for="message" class="text-sm font-medium">Mensaje</label>
          <textarea
            id="message"
            name="message"
            rows="6"
            required
            class="rounded-sm border border-line bg-paper px-4 py-3 text-ink"
          ></textarea>
        </div>

        <!-- Honeypot anti-spam: oculto para personas, visible para bots. -->
        <div class="hidden" aria-hidden="true">
          <label for="website">Sitio web</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="flex flex-wrap items-center gap-4">
          <Button type="submit" size="lg">Enviar mensaje</Button>
          <p class="text-xs text-muted">
            Al enviar aceptas que usemos tus datos solo para responderte. PLACEHOLDER: enlazar a la
            política de privacidad.
          </p>
        </div>
      </form>

      <aside class="reveal reveal-delay-1 col-span-12 md:col-span-4 md:col-start-9">
        <h2 class="eyebrow">Otras vías</h2>
        <address class="mt-4 grid gap-3 not-italic">
          {email && <a href={`mailto:${email}`} class="text-lg text-ink">{email}</a>}
          {phone && <a href={`tel:${phone.replace(/\s+/g, '')}`} class="text-lg text-ink">{phone}</a>}
          {address && (
            <p class="text-muted">
              {address.streetAddress}<br />
              {address.postalCode} {address.addressLocality}, {address.addressRegion}
            </p>
          )}
          {!email && !phone && !address && (
            <p class="text-muted">
              Datos de contacto pendientes: rellena <code>SITE.contact</code> en
              <code>src/config/site.ts</code>.
            </p>
          )}
        </address>
        {openingHours.length > 0 && (
          <>
            <h2 class="eyebrow mt-8">Horario</h2>
            <ul class="mt-3 grid gap-1 text-muted" role="list">
              {openingHours.map((h) => <li>{h}</li>)}
            </ul>
          </>
        )}
      </aside>
    </div>
  </Section>
</Base>
