{
  // Cloudflare Workers Static Assets — sitio 100 % estático, sin código de Worker.
  // Deploy: `npm run build && npx wrangler deploy`
  // Docs: https://developers.cloudflare.com/workers/static-assets/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astro-marketing", // PLACEHOLDER: nombre del Worker
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Sirve dist/404.html con estado 404 real (no la portada).
    "not_found_handling": "404-page",
    // `/contacto` y `/contacto/` resuelven a contacto/index.html; redirige para una única URL canónica.
    "html_handling": "auto-trailing-slash"
  }
}
